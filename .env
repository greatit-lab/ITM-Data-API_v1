# ITM-Data-API/.env

# 1. Live DB 연결 (최근 2개월 데이터)
DATABASE_URL="postgresql://postgres:pw@[DB서버IP]:5432/itm?schema=public&connection_limit=70"

# [추가] 2. Archive DB 연결 (과거 데이터 전용 DBaaS)
ARCHIVE_DATABASE_URL="postgresql://adminuser:pw@[DB서버IP]:5432/itm?schema=public&connection_limit=70"

# [추가] 3. 데이터 조회 라우팅 및 보호 정책 설정
ARCHIVE_MONTHS_THRESHOLD="2"  # 라이브/아카이브를 가르는 기준 (2개월 전)
ARCHIVE_MAX_SEARCH_DAYS="31"  # 아카이브 DB 최대 동시 조회 가능 일수 (8GB 메모리 보호)

# 2. 엔진 파일 자동 다운로드 및 체크섬 검증 방지 (필수)
PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING="1"

# 3. [핵심] 모든 엔진 파일의 로컬 경로를 명시적으로 지정
# (파일을 복사한 위치: itm-data-api/prisma/engines/ 폴더 기준)

# 쿼리 엔진 (실행 시 필요)
PRISMA_QUERY_ENGINE_LIBRARY="./prisma/engines/query_engine.dll.node"

# 스키마 엔진 (Generate/Migrate 시 필요)
PRISMA_SCHEMA_ENGINE_BINARY="./prisma/engines/schema-engine.exe"

# 마이그레이션 엔진 (구버전 호환용)
PRISMA_MIGRATION_ENGINE_BINARY="./prisma/engines/migration-engine.exe"

# 포매팅 도구
PRISMA_FMT_BINARY="./prisma/engines/prisma-fmt.exe"

# PDF 파일 서버 (itmuploadapi 8082 포트 반영)
PDF_SERVER_BASE_URL="http://[DB서버IP]:8082"

UPLOAD_API_URL="http://[DB서버IP]:8082"

# Poppler 라이브러리 bin 폴더 경로 (ITM-DATA-API 서버 내 실제 설치 경로)
# 예: "D:\\Services\\ITM-Data-API\\poppler\\Library\\bin"
POPPLER_BIN_PATH="D:\\ITM-Data-API\\poppler\\Library\\bin"
